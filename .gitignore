# Reasonix 工具
.reasonix/

# 运行时 agent 会话产物（不入库）
.agentteam/

# 模型文件（大文件，不入库；用 models/download_models.sh 下载）
models/*.gguf

# 上游 llama.cpp：独立 git 仓库，阶段 2 的改动在其内部提交管理
llama.cpp/

# 构建产物
build*/
*.o
*.a

# Python / uv 虚拟环境与缓存
__pycache__/
*.pyc
.venv/
venv/

# 运行期临时输出（正式基线归档至 benchmark/baseline/）
benchmark/results/
!benchmark/results/kv_optimization/
!benchmark/results/kv_optimization/*.json
!benchmark/results/kv_optimization/raw/
papers/kv-cache/pdf/
