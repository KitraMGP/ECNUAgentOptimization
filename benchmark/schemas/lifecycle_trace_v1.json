{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECNUAgentOptimization lifecycle trace v1（匿名）",
  "description": "真实 Agent 流量 trace schema：只保存请求到达间隔、session 匿名 id、turn 序号、prompt token 长度、公共前缀长度、生成 token 数、结束状态、回访间隔。不保存 prompt/response/token 文本、secret、用户标识或可逆内容。",
  "type": "object",
  "required": ["schema_version", "sessions"],
  "properties": {
    "schema_version": { "const": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["session_id", "requests"],
        "properties": {
          "session_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
          "requests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["turn", "prompt_tokens", "prompt_prefix_tokens", "gen_tokens", "status"],
              "properties": {
                "turn": { "type": "integer", "minimum": 1 },
                "arrival_delta_ms": { "type": "integer", "minimum": 0 },
                "prompt_tokens": { "type": "integer", "minimum": 1 },
                "prompt_prefix_tokens": { "type": "integer", "minimum": 0 },
                "gen_tokens": { "type": "integer", "minimum": 0 },
                "status": { "enum": ["ok", "truncated", "error"] },
                "revisit_delta_ms": { "type": ["integer", "null"], "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
